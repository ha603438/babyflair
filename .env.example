# Mode partagé (Supabase). Les deux variables sont lues au build par Vite ; si l'une manque, l'app reste 100 % locale
# (c'est le cas en développement et dans les tests). La clé anon est publique : l'accès est protégé par le code du
# bureau (en-tête x-office-code vérifié par les règles RLS, voir docs/supabase/schema.sql).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Notifications (Web Push). Clé publique VAPID, la même que le secret VAPID_PUBLIC_KEY de la fonction notify-call
# (voir README › Notifications). Absente, la ligne Réglages › Notifications reste « Non pris en charge ».
VITE_VAPID_PUBLIC_KEY=BFVFtuU4dwV4wwiR_Gx1Bo5u5EnLz5fhTyr5CRzHxSw7QywnRaNlx4Hz-E3_MABlZfaN3xRb-wUIhOy3MWsaE0Q
